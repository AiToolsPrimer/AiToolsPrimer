# Only fill in the platforms you use. Everything else stays off.
# Bluesky: Settings > Privacy and Security > App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Mastodon: Preferences > Development > New application (read write)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=
# X: developer.x.com app with OAuth 1.0a user context (free tier, write-only)
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# YouTube Data API v3: OAuth client (desktop) + refresh token with youtube.upload + youtube.force-ssl scopes
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Reddit 'script' app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=u_aitoolsprimer
# Telegram channel via a bot that is channel admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@aitoolsprimer
# Meta
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
PUBLIC_MEDIA_BASE_URL=   # e.g. https://aitoolsprimer.com/media  (Instagram/Threads fetch media from a public URL)
# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
# Pinterest
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# WordPress
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
# DEV Community
DEVTO_API_KEY=
# Hashnode
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
# Tumblr
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_TOKEN=
TUMBLR_TOKEN_SECRET=
TUMBLR_BLOG=
# Vimeo (personal access token: upload + edit)
VIMEO_ACCESS_TOKEN=
# Mail (read-only IMAP; Gmail app password from Google Account > Security > App passwords). Also enables saving drafts to Gmail.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USER=
MAIL_APP_PASSWORD=
# Optional paid director (off unless director.provider: anthropic)
ANTHROPIC_API_KEY=
